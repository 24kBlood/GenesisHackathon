FROM docker.io/library/python:3.11-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535 AS dependencies

ARG PIP_FIND_LINKS=""
RUN if [ -n "${PIP_FIND_LINKS}" ]; then \
      python -m pip install --no-index --find-links="${PIP_FIND_LINKS}" --no-deps \
        --target=/offline-deps tzdata==2025.2; \
    else \
      python -m pip download --only-binary=:all: --no-deps --dest /wheels tzdata==2025.2 \
      && python -m pip install --no-index --find-links=/wheels --no-deps \
         --target=/offline-deps tzdata==2025.2; \
    fi

FROM docker.io/library/python:3.11-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535

WORKDIR /app
COPY --from=dependencies /offline-deps /usr/local/lib/python3.11/site-packages/
COPY LICENSE NOTICE ./
COPY src/genesis/__init__.py src/genesis/__init__.py
COPY src/genesis/domain/ src/genesis/domain/
COPY src/genesis/environment/__init__.py src/genesis/environment/jsonl.py src/genesis/environment/
COPY src/genesis/policies/ src/genesis/policies/

ENV PYTHONPATH=/app/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONTZPATH=""
USER 65532:65532
ENTRYPOINT ["python", "-m", "genesis.policies.worker"]
CMD ["simple_reconciliation"]
