{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.genesis.invalid/v1/invoice.schema.json",
  "title": "Public invoice document",
  "type": "object",
  "properties": {
    "doc_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "invoice_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "entity_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "issued_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "due_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "currency": {
      "$ref": "common.schema.json#/$defs/currency"
    },
    "total_minor": {
      "$ref": "common.schema.json#/$defs/minor"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price_minor": {
            "$ref": "common.schema.json#/$defs/minor"
          },
          "amount_minor": {
            "$ref": "common.schema.json#/$defs/minor"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "doc_id",
    "invoice_id",
    "entity_id",
    "issued_at",
    "due_at",
    "currency",
    "total_minor",
    "line_items"
  ],
  "additionalProperties": false
}
