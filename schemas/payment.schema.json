{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.genesis.invalid/v1/payment.schema.json",
  "title": "Public payment document",
  "type": "object",
  "properties": {
    "doc_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "payment_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "timestamp": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "currency": {
      "$ref": "common.schema.json#/$defs/currency"
    },
    "amount_minor": {
      "$ref": "common.schema.json#/$defs/minor"
    },
    "payment_kind": {
      "const": "refund"
    },
    "refund_of_payment_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "invoice_refs": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "doc_id",
    "payment_id",
    "timestamp",
    "currency",
    "amount_minor",
    "invoice_refs"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "payment_kind": ["refund_of_payment_id"],
    "refund_of_payment_id": ["payment_kind"]
  },
  "if": {
    "required": ["payment_kind"]
  },
  "then": {
    "properties": {
      "amount_minor": {"minimum": 1},
      "invoice_refs": {"type": "array", "minItems": 1}
    }
  }
}
