{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.genesis.invalid/v1/config.schema.json",
  "title": "Generation configuration",
  "description": "Normalized v1 episode generation configuration. Optional fields default to the compact v1 baseline profile when omitted.",
  "type": "object",
  "$defs": {
    "supported_currency": {
      "enum": ["EUR", "GBP", "JPY", "KZT", "USD"]
    }
  },
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/version",
      "description": "Data contract schema version."
    },
    "error_counts": {
      "type": "object",
      "description": "Independent injected error counts per canonical finding type.",
      "properties": {
        "duplicate_invoice": {
          "type": "integer",
          "minimum": 0
        },
        "payment_allocation": {
          "type": "integer",
          "minimum": 0
        },
        "fx_conversion": {
          "type": "integer",
          "minimum": 0
        },
        "period_cutoff": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "interaction_scenarios": {
      "type": "array",
      "description": "Additive interacting multi-error scenarios.",
      "items": {
        "type": "string",
        "enum": [
          "partial_fx_payment_at_cutoff",
          "duplicate_invoice_with_fx"
        ]
      },
      "uniqueItems": true
    },
    "include_distractors": {
      "type": "boolean",
      "description": "Whether to include legitimate split payments, overpayment refunds, and same-vendor equal-amount obligations."
    },
    "obligation_count": {
      "type": "integer",
      "minimum": 4,
      "maximum": 500,
      "description": "Number of base obligations before distractors and interaction scenarios (defaults to 4)."
    },
    "base_currency": {
      "$ref": "#/$defs/supported_currency",
      "description": "Company reporting/ledger currency (defaults to KZT)."
    },
    "foreign_currency": {
      "$ref": "#/$defs/supported_currency",
      "description": "Primary foreign invoice/payment currency (defaults to JPY)."
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "description": "IANA timezone name for period boundaries and FX date resolution (defaults to Asia/Almaty)."
    },
    "fx_date_rule": {
      "type": "string",
      "enum": [
        "payment_date",
        "invoice_date"
      ],
      "description": "Accounting policy rule for selecting the FX quote date (defaults to payment_date)."
    }
  },
  "required": [
    "schema_version",
    "error_counts"
  ],
  "allOf": [
    {
      "if": { "required": ["fx_date_rule"], "properties": { "fx_date_rule": { "const": "invoice_date" } } },
      "then": { "properties": { "interaction_scenarios": { "maxItems": 0 } } }
    },
    {
      "not": {
        "anyOf": [
          {
            "required": ["base_currency"],
            "properties": { "base_currency": { "const": "JPY" }, "foreign_currency": { "const": "JPY" } }
          },
          {
            "required": ["foreign_currency"],
            "properties": { "base_currency": { "const": "KZT" }, "foreign_currency": { "const": "KZT" } }
          },
          {
            "required": ["base_currency", "foreign_currency"],
            "properties": { "base_currency": { "const": "EUR" }, "foreign_currency": { "const": "EUR" } }
          },
          {
            "required": ["base_currency", "foreign_currency"],
            "properties": { "base_currency": { "const": "GBP" }, "foreign_currency": { "const": "GBP" } }
          },
          {
            "required": ["base_currency", "foreign_currency"],
            "properties": { "base_currency": { "const": "USD" }, "foreign_currency": { "const": "USD" } }
          }
        ]
      }
    }
  ],
  "additionalProperties": false
}
