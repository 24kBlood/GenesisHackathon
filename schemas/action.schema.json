{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.genesis.invalid/v1/action.schema.json",
  "title": "Public auditor action",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "list_records"
        },
        "table": {
          "$ref": "common.schema.json#/$defs/table"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "type",
        "table"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "get_record"
        },
        "table": {
          "$ref": "common.schema.json#/$defs/table"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        }
      },
      "required": [
        "type",
        "table",
        "id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "get_document"
        },
        "doc_id": {
          "$ref": "common.schema.json#/$defs/id"
        }
      },
      "required": [
        "type",
        "doc_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "calculator"
        },
        "expression": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "expression"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "submit"
        },
        "findings": {
          "$ref": "findings.schema.json"
        }
      },
      "required": [
        "type",
        "findings"
      ],
      "additionalProperties": false
    }
  ]
}
