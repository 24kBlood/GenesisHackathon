{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.genesis.invalid/v1/common.schema.json",
  "title": "Genesis v1 shared scalar definitions",
  "description": "Shared scalar types, bounds, and enums for Genesis v1 public and evaluator wire schemas.",
  "$defs": {
    "id": {
      "description": "Non-empty UTF-8 identifier up to 128 characters (no lone UTF-16 surrogates).",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "currency": {
      "description": "Three-letter uppercase ISO 4217 currency code.",
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "minLength": 3,
      "maxLength": 3
    },
    "date": {
      "description": "Calendar date in YYYY-MM-DD format.",
      "type": "string",
      "format": "date"
    },
    "timestamp": {
      "description": "RFC 3339 timestamp with explicit UTC offset or Z suffix.",
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])"
    },
    "rate": {
      "description": "Positive fixed-point decimal FX rate serialized as a string.",
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$(?![\\s\\S])",
      "not": {
        "pattern": "^0+(?:\\.0+)?$"
      }
    },
    "version": {
      "description": "Genesis v1 schema contract version.",
      "const": "1.0.0"
    },
    "minor": {
      "description": "Monetary amount in integer minor units of the associated currency.",
      "type": "integer"
    },
    "rounding": {
      "description": "Python decimal rounding mode applied during FX conversion.",
      "enum": [
        "ROUND_CEILING",
        "ROUND_DOWN",
        "ROUND_FLOOR",
        "ROUND_HALF_DOWN",
        "ROUND_HALF_EVEN",
        "ROUND_HALF_UP",
        "ROUND_UP",
        "ROUND_05UP"
      ]
    },
    "error_type": {
      "description": "Canonical financial audit discrepancy class.",
      "enum": [
        "duplicate_invoice",
        "payment_allocation",
        "fx_conversion",
        "period_cutoff"
      ]
    },
    "table": {
      "description": "Public read-only accounting table name.",
      "enum": [
        "ledger",
        "invoices",
        "payments",
        "fx"
      ]
    }
  }
}
