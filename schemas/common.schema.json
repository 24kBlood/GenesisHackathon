{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.genesis.invalid/v1/common.schema.json",
  "title": "Genesis v1 shared scalar definitions",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "minLength": 3,
      "maxLength": 3
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])"
    },
    "rate": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$(?![\\s\\S])",
      "not": {
        "pattern": "^0+(?:\\.0+)?$"
      }
    },
    "version": {
      "const": "1.0.0"
    },
    "minor": {
      "type": "integer"
    },
    "rounding": {
      "enum": [
        "ROUND_CEILING",
        "ROUND_DOWN",
        "ROUND_FLOOR",
        "ROUND_HALF_DOWN",
        "ROUND_HALF_EVEN",
        "ROUND_HALF_UP",
        "ROUND_UP",
        "ROUND_05UP"
      ]
    },
    "error_type": {
      "enum": [
        "duplicate_invoice",
        "payment_allocation",
        "fx_conversion",
        "period_cutoff"
      ]
    },
    "table": {
      "enum": [
        "ledger",
        "invoices",
        "payments",
        "fx"
      ]
    }
  }
}
